server {
  listen 80;
  listen [::]:80;
  server_name smartergpt.dev www.smartergpt.dev;
  return 301 https://$host$request_uri;
}

server {
  listen 443 ssl;
  listen [::]:443 ssl;
  http2 on;

  server_name smartergpt.dev www.smartergpt.dev;

  ssl_certificate     /etc/letsencrypt/live/smartergpt.dev/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/smartergpt.dev/privkey.pem;

  root /var/www/html;
  index index.html;

  location / {
    try_files $uri $uri/ /index.html;  # Vite SPA fallback
  }
}
