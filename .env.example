# smartergpt.dev — example env (do NOT commit real secrets)
# Copy to `.env` and fill in real values locally.

# Cloudflared (token mode)
# Provide TUNNEL_TOKEN in your real .env (never commit actual value). Example placeholder below intentionally
# avoids patterns that secret scanners flag.
TUNNEL_ID=00000000-0000-0000-0000-000000000000
TUNNEL_TOKEN=__REDACTED_TUNNEL_TOKEN__

# Optional: Cloudflare origin cert/key file paths inside the container
ORIGIN_CERT_PATH=/etc/nginx/certs/origin_cert.pem
ORIGIN_KEY_PATH=/etc/nginx/certs/origin_key.pem

# Build stamps (set by CI/CD)
BUILD_ID=dev-local
GIT_SHA=unknown
